# =============================================================================
# Healthcare AI Assistant — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# LLM provider: ollama | openai | anthropic
# Use ollama for local/on-premise LLM (no API key needed, recommended)
LLM_PROVIDER=ollama

# Ollama settings (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI settings (only needed if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic settings (only needed if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Embeddings model (sentence-transformers, runs locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./vector_store
CHROMA_COLLECTION_NAME=healthcare_docs

# RAG settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
MIN_SIMILARITY_SCORE=0.30

# Data directory
DATA_DIR=./data

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
